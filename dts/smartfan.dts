/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/tegra234-gpio.h>

/ {
	compatible = "nvidia,p3768-0000+p3767-0005-super",
		     "nvidia,p3768-0000+p3767-0005";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			smartfan {
				compatible = "edu,jetson-smartfan";
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <&smartfan_output>;
				/* J12 physical 32: PG.06; gpiochip line offset 41. */
				enable-gpios = <&gpio TEGRA234_MAIN_GPIO(G, 6)
						GPIO_ACTIVE_HIGH>;
				/* J12 physical 15: PN.01, PWM1 channel 0, 250 Hz. */
				pwms = <&pwm1 0 4000000>;
				pwm-names = "motor";
				/* J12 physical 29: PQ.05; gpiochip line offset 105. */
				in2-gpios = <&gpio TEGRA234_MAIN_GPIO(Q, 5)
					     GPIO_ACTIVE_HIGH>;
				lease-timeout-ms = <2000>;
				max-on-ms = <30000>;
				startup-boost-ms = <200>;
				/* Segments 1..8: J12 physical 13,16,18,22,33,35,37,40. */
				led-gpios = <&gpio TEGRA234_MAIN_GPIO(Y, 0) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(Y, 4) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(Y, 3) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(Y, 1) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(H, 0) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(I, 2) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(Y, 2) GPIO_ACTIVE_HIGH>,
					    <&gpio TEGRA234_MAIN_GPIO(I, 0) GPIO_ACTIVE_HIGH>;
			};
		};
	};

	fragment@1 {
		target = <&pinmux>;
		__overlay__ {
			smartfan_output: smartfan-output {
				outputs {
					/* Motor enable and fixed reverse-direction interlock. */
					nvidia,pins = "soc_gpio19_pg6",
						      "soc_gpio32_pq5";
					nvidia,tristate = <0>;
					nvidia,enable-input = <0>;
					/* GPIO mode: PADCTL SFSEL bit is zero. */
					nvidia,gpio-mode = <0>;
				};
				encoder-inputs {
					/* J12 physical 12 and 38; requested by userspace only. */
					nvidia,pins = "soc_gpio41_ph7", "soc_gpio43_pi1";
					nvidia,tristate = <1>;
					nvidia,enable-input = <1>;
					nvidia,gpio-mode = <0>;
					nvidia,pull = <0>;
				};
				led-outputs {
					nvidia,pins = "spi3_sck_py0", "spi3_cs1_py4",
						      "spi3_cs0_py3", "spi3_miso_py1",
						      "soc_gpio21_ph0", "soc_gpio44_pi2",
						      "spi3_mosi_py2", "soc_gpio42_pi0";
					nvidia,tristate = <0>;
					nvidia,enable-input = <0>;
					nvidia,gpio-mode = <0>;
					nvidia,open-drain = <0>;
					nvidia,pull = <0>;
				};
			};
			smartfan_pwm: smartfan-pwm {
				pwm-output {
					nvidia,pins = "soc_gpio39_pn1";
					nvidia,function = "gp";
					nvidia,tristate = <0>;
					nvidia,enable-input = <0>;
					nvidia,gpio-mode = <1>;
				};
			};
		};
	};

	fragment@2 {
		target = <&pwm1>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			/* PWM runtime resume must restore its own SFIO pad state. */
			pinctrl-0 = <&smartfan_pwm>;
		};
	};
	fragment@3 {
		/* Header SPI1 uses the same PY pads as LED segments 1..4/7. */
		target-path = "/bus@0/spi@3230000";
		__overlay__ {
			status = "disabled";
		};
	};
	fragment@4 {
		target-path = "/bus@0/i2c@c250000";
		__overlay__ {
			/* PCF8574T supports Standard-mode (100 kHz), not 400 kHz. */
			clock-frequency = <100000>;
		};
	};
};
